#!/bin/sh
set -eu

message_file=$1
subject=$(sed -n '1p' "$message_file")

# The first commit predates this convention.
if [ "$subject" = 'Initial commit' ] && ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    exit 0
fi

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)\((app|ui|notes|todos|appointments|settings|persistence|security|build|release|docs|deps|tests)\): [^[:space:]].*$'; then
    exit 0
fi

printf '%s\n' 'Invalid commit message. Use type(scope): description.' >&2
printf '%s\n' 'See README.md for allowed types and scopes.' >&2
exit 1
